# Copy to .env in the directory you run the command from. Never commit .env.
# The endpoint is derived from B2_REGION (https://s3.<region>.backblazeb2.com).
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_REGION=us-west-004
# B2_PUBLIC_URL_BASE=

# LiveKit API key and secret that sign the webhooks (handle-webhook and serve).
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:backblaze:b2-voice-ai-reference-architectures:session-manifest:1",
  "title": "Voice agent session manifest",
  "description": "Written when a voice agent session ends. It lists the archived recordings, the consent that covers them, the retention class and the result of the session quality and safety evaluation. Only a session whose evaluation passed may be selected for review, analytics or model improvement.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "started_at",
    "ended_at",
    "duration_seconds",
    "source",
    "participants",
    "recordings",
    "consent_ids",
    "retention",
    "evaluation"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "capture"
      ],
      "properties": {
        "platform": {
          "enum": [
            "livekit",
            "pipecat",
            "twilio",
            "daily",
            "vapi",
            "other"
          ]
        },
        "capture": {
          "enum": [
            "native-s3-output",
            "application-copy"
          ],
          "description": "native-s3-output: the platform writes to B2 through an S3-compatible endpoint. application-copy: the application copies the recording to B2 after the platform delivers it."
        }
      }
    },
    "participants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "participant_id",
          "role"
        ],
        "properties": {
          "participant_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "role": {
            "enum": [
              "caller",
              "agent",
              "observer"
            ]
          }
        }
      }
    },
    "recordings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "path",
          "size",
          "sha256",
          "encoding_format"
        ],
        "properties": {
          "kind": {
            "enum": [
              "mixed",
              "participant-track",
              "transcript",
              "events"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^(?!.*\\.\\.)(?!/)[A-Za-z0-9_./=-]+$",
            "description": "Object key relative to the session prefix."
          },
          "participant_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "encoding_format": {
            "type": "string",
            "minLength": 1
          },
          "sample_rate_hz": {
            "type": "integer",
            "minimum": 8000
          },
          "channels": {
            "type": "integer",
            "minimum": 1
          },
          "duration_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "consent_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]*$"
      },
      "description": "Consent and license records that cover the recordings. A session needs at least one before it can be selected for model improvement."
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class"
      ],
      "properties": {
        "class": {
          "enum": [
            "short",
            "standard",
            "extended",
            "legal-hold"
          ]
        },
        "delete_after": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evaluator",
        "eligible_for"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "passed",
            "flagged",
            "failed"
          ]
        },
        "evaluated_at": {
          "type": "string",
          "format": "date-time"
        },
        "evaluator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "quality": {
          "$ref": "#/$defs/check_group"
        },
        "safety": {
          "$ref": "#/$defs/check_group"
        },
        "eligible_for": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "human-review",
              "analytics",
              "model-improvement"
            ]
          },
          "description": "Uses the session may be selected for. Empty unless the evaluation passed."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "pending",
                  "flagged",
                  "failed"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "eligible_for": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "passed",
                  "flagged",
                  "failed"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "evaluated_at",
              "quality",
              "safety"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "passed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "quality": {
                "properties": {
                  "status": {
                    "const": "pass"
                  }
                }
              },
              "safety": {
                "properties": {
                  "status": {
                    "const": "pass"
                  }
                }
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "evaluation": {
            "properties": {
              "eligible_for": {
                "contains": {
                  "const": "model-improvement"
                }
              }
            },
            "required": [
              "eligible_for"
            ]
          }
        },
        "required": [
          "evaluation"
        ]
      },
      "then": {
        "properties": {
          "consent_ids": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "check_group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "checks"
      ],
      "properties": {
        "status": {
          "enum": [
            "pass",
            "warn",
            "fail"
          ]
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "result"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]*$"
              },
              "result": {
                "enum": [
                  "pass",
                  "warn",
                  "fail"
                ]
              },
              "detail": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:backblaze:b2-voice-ai-reference-architectures:consent-record:1",
  "title": "Voice consent and license record",
  "description": "Records who may be heard in a recording, what the recording may be used for and under which license. The record holds opaque references only: no names, contact details or copies of signed documents.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "consent_id",
    "subject",
    "status",
    "granted_at",
    "permitted_uses",
    "license",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "consent_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "speaker_id"
      ],
      "properties": {
        "type": {
          "enum": [
            "human",
            "synthetic"
          ],
          "description": "synthetic means the voice was generated and no person is recorded."
        },
        "speaker_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "description": "Pseudonymous id used in manifests."
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "status": {
      "enum": [
        "active",
        "revoked",
        "expired"
      ]
    },
    "granted_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "revoked_at": {
      "type": "string",
      "format": "date-time"
    },
    "permitted_uses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "training",
          "evaluation",
          "analytics",
          "generation",
          "redistribution"
        ]
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifier"
      ],
      "properties": {
        "identifier": {
          "type": "string",
          "minLength": 1,
          "description": "SPDX license identifier or LicenseRef value."
        },
        "attribution": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reference"
      ],
      "properties": {
        "kind": {
          "enum": [
            "signed-form",
            "recorded-statement",
            "terms-acceptance",
            "not-applicable-synthetic"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "description": "Opaque pointer to the evidence held elsewhere, for example a protected object key."
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "revoked"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "revoked_at"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "expired"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "expires_at"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "subject": {
            "properties": {
              "type": {
                "const": "synthetic"
              }
            },
            "required": [
              "type"
            ]
          }
        },
        "required": [
          "subject"
        ]
      },
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "kind": {
                "const": "not-applicable-synthetic"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "evidence": {
            "properties": {
              "kind": {
                "enum": [
                  "signed-form",
                  "recorded-statement",
                  "terms-acceptance"
                ]
              }
            }
          }
        }
      }
    }
  ]
}

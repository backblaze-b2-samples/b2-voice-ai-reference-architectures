# Copy this file to .env in the directory you run the command from.
# The command reads .env from the current directory only, never from a parent directory,
# and variables already set in the environment take precedence.
B2_APPLICATION_KEY_ID=<key-id>
B2_APPLICATION_KEY=<application-key>
B2_BUCKET_NAME=<bucket-name>
B2_REGION=us-west-004
# B2_PUBLIC_URL_BASE=

# Needed only by handle-event: the signing secret of the Event Notification rule.
B2_EVENT_SIGNING_SECRET=<event-signing-secret>

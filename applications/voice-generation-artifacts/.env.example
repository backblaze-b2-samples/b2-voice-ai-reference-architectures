# Copy to .env in the directory you run voice-generation-artifacts from and fill it in.
# The endpoint is derived from B2_REGION; there is no endpoint setting.
B2_APPLICATION_KEY_ID=<key-id>
B2_APPLICATION_KEY=<application-key>
B2_BUCKET_NAME=<bucket-name>
B2_REGION=us-west-004
# Optional and unused by this tool: the bucket stays private and the delivery manifest is never served from a public URL.
# B2_PUBLIC_URL_BASE=
